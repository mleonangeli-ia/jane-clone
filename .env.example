# Core application
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jane_clone?schema=public"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CAPTCHA_SECRET=""

# Email
RESEND_API_KEY=""
FROM_EMAIL="Turnos <turnos@example.com>"

# Scheduled reminders
CRON_SECRET=""

# Mercado Pago — keep disabled until both credentials are configured
PAYMENTS_ENABLED="false"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Web Push — generate one persistent pair and keep the private JWK secret
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@example.com"

# Google Calendar — client ID and secret must be configured together
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AFIP certificate encryption — independent from NEXTAUTH_SECRET
AFIP_ENCRYPTION_KEY=""
